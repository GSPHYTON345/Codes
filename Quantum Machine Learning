# 3. Load CSVs
spx_df   = pd.read_csv(spx_path)
vix_df   = pd.read_csv(vix_path)
us10y_df = pd.read_csv(us10y_path)

# 4. Standardize column names and convert time/date columns
for df in [spx_df, vix_df, us10y_df]:
    df.columns = [c.strip().lower() for c in df.columns]
    # Try UNIX timestamp, else generic date conversion
    try:
        df['time'] = pd.to_datetime(df['time'], unit='s', errors='coerce')
    except:
        df['time'] = pd.to_datetime(df['time'], errors='coerce')
    df['date'] = df['time'].dt.date

# 5. Merge on 'date'
spx_df = spx_df[['date', 'open', 'high', 'low', 'close']]
vix_df = vix_df[['date', 'close']].rename(columns={'close':'vix'})
us10y_df = us10y_df[['date', 'close']].rename(columns={'close':'us10y'})
df = spx_df.merge(vix_df, on='date', how='inner')
df = df.merge(us10y_df, on='date', how='inner')
print(f'After merging: {df.shape[0]} rows')
print(df.head())

# 6. S-value calculation, lag features, and signals
window = 3
delta = 1
fixed_threshold = 1.0
sum_threshold = 3.5

df['spx'] = df['close']
df['spx_lag'] = df['close'].shift(delta)
df['vix_lag'] = df['vix'].shift(delta)
df['us10y_lag'] = df['us10y'].shift(delta)

def calc_S(x, y):
    c0 = x.rolling(window).corr(y)
    c1 = x.shift(delta).rolling(window).corr(y)
    c2 = x.rolling(window).corr(y.shift(delta))
    c3 = x.shift(delta).rolling(window).corr(y.shift(delta))
    return (c0 + c1 + c2 - c3).abs()

df['S_vix']   = calc_S(df['spx'], df['vix'])
df['S_us10y'] = calc_S(df['spx'], df['us10y'])

df['sig_vix']   = df['S_vix']   > fixed_threshold
df['sig_us10y'] = df['S_us10y'] > fixed_threshold

df['dir_vix']   = np.where(df['vix_lag']   > df['vix'],   -1, 1)
df['dir_us10y'] = np.where(df['us10y_lag'] > df['us10y'], -1, 1)

df['combined_dir'] = (df['sig_vix'] * df['dir_vix']) + (df['sig_us10y'] * df['dir_us10y'])
df['sum_s'] = df['S_vix'] + df['S_us10y']
df['long_entry'] = (df['combined_dir'] == 2) & (df['sum_s'] > sum_threshold)
df['Long Signal'] = df['long_entry'].astype(int)

# 7. --- Quantum Moment Section ---
# Quantum moment = S_vix or S_us10y exceeds threshold
df['is_quantum'] = (df['S_vix'] > fixed_threshold) | (df['S_us10y'] > fixed_threshold)

# Stats
quantum_stats = df['is_quantum'].value_counts()
print('Quantum moments:', quantum_stats.get(True, 0))
print('Non-quantum moments:', quantum_stats.get(False, 0))

# Plot quantum moments on SPX chart
plt.figure(figsize=(14,6))
plt.plot(df['date'], df['spx'], label='SPX Close')
plt.scatter(df.loc[df['is_quantum'], 'date'], df.loc[df['is_quantum'], 'spx'],
            color='red', label='Quantum Moments', marker='o')
plt.title('SPX with Quantum Moments Highlighted')
plt.legend()
plt.show()

# Analyze quantum moment durations and clustering
df['quantum_shift'] = df['is_quantum'] != df['is_quantum'].shift(1)
df['quantum_group'] = df['quantum_shift'].cumsum()
quantum_durations = df.groupby('quantum_group')['is_quantum'].sum()
quantum_runs = quantum_durations[quantum_durations > 0]
print(f'Number of quantum runs: {len(quantum_runs)}')
print(f'Average quantum run duration: {quantum_runs.mean():.2f} days')
print('Quantum run duration distribution:')
print(quantum_runs.value_counts())

# Compare volatility and mean return in/out of quantum periods
df['return'] = df['spx'].pct_change()
quantum_vol = df.loc[df['is_quantum'], 'return'].std()
non_quantum_vol = df.loc[~df['is_quantum'], 'return'].std()
quantum_mean = df.loc[df['is_quantum'], 'return'].mean()
non_quantum_mean = df.loc[~df['is_quantum'], 'return'].mean()
print(f"Quantum volatility: {quantum_vol:.4f}")
print(f"Non-quantum volatility: {non_quantum_vol:.4f}")
print(f"Quantum mean return: {quantum_mean:.4f}")
print(f"Non-quantum mean return: {non_quantum_mean:.4f}")

# Correlation between S_vix and S_us10y during quantum moments
corr_quantum = df.loc[df['is_quantum'], ['S_vix', 'S_us10y']].corr()
print("Correlation of S_vix and S_us10y during quantum moments:")
print(corr_quantum)

# (Optional) Save quantum moments for further study
df[df['is_quantum']].to_csv('/content/drive/MyDrive/quantum_moments.csv', index=False)

# 8. --- SVM Preparation (full data) ---
feature_cols = ['spx', 'vix', 'us10y', 'S_vix', 'S_us10y', 'sum_s']
label_col = 'Long Signal'
df = df.dropna(subset=feature_cols + [label_col])

print(f'Rows after dropping NaNs: {df.shape[0]}')
print("Long Signal value counts:")
print(df[label_col].value_counts())
print(df[['date', 'sum_s', 'combined_dir', label_col]].tail(30))

X = df[feature_cols].values
y = df[label_col].astype(int).values
unique_classes = np.unique(y)
print("Unique classes in y:", unique_classes)
if len(unique_classes) < 2:
    print("Not enough class diversity for classification. Try adjusting the thresholds or window/delta size.")

# 9. --- Quantum SVM, Full Data ---
if len(X) < 5:
    print("Not enough data after cleaning for training/testing split.")
else:
    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=0.2, stratify=y, random_state=42)
    feature_map = ZZFeatureMap(feature_dimension=X.shape[1], reps=2, entanglement='linear')
    backend = AerSimulator()
    quantum_kernel = FidelityQuantumKernel(feature_map=feature_map)
    kernel_matrix_train = quantum_kernel.evaluate(x_vec=X_train)
    kernel_matrix_test = quantum_kernel.evaluate(x_vec=X_test, y_vec=X_train)
    svm = SVC(kernel='precomputed')
    svm.fit(kernel_matrix_train, y_train)
    y_pred = svm.predict(kernel_matrix_test)
    print("\n--- Quantum SVM, Full Data ---")
    print(classification_report(y_test, y_pred, digits=4))

# 10. --- Quantum SVM, Quantum Moments Only ---
df_quantum = df[df['is_quantum']].dropna(subset=feature_cols + [label_col])
if len(df_quantum) >= 5:
    Xq = df_quantum[feature_cols].values
