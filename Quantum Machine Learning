# 3. Decoherence: Post-quantum return
df['quantum_start'] = (df['is_quantum']) & (~df['is_quantum'].shift(1, fill_value=False))
df['quantum_end'] = (~df['is_quantum']) & (df['is_quantum'].shift(1, fill_value=False))
df['after_quantum_return'] = df['return'].shift(-1).rolling(3).mean()
after_decoherence = df.loc[df['quantum_end'], 'after_quantum_return'].mean()
print(f"Mean return in 3 days after decoherence (quantum end): {after_decoherence:.4f}")

# 4. Collapse: Regime flip after quantum period ends
collapse_points = df.loc[df['quantum_end']].index
collapse_changes = 0
for idx in collapse_points:
    if idx+1 in df.index and df.at[idx+1, 'combined_dir'] != 0:
        if np.sign(df.at[idx, 'combined_dir']) != np.sign(df.at[idx+1, 'combined_dir']):
            collapse_changes += 1
print(f"Collapse events (regime flips after quantum): {collapse_changes}")

# 5. Entropy: Disorder in quantum vs non-quantum returns
from scipy.stats import entropy
def shannon_entropy(series, bins=3):
    hist, _ = np.histogram(series.dropna(), bins=bins)
    probs = hist / np.sum(hist)
    return entropy(probs, base=2)

quantum_entropy = shannon_entropy(df.loc[df['is_quantum'], 'return'], bins=5)
non_quantum_entropy = shannon_entropy(df.loc[~df['is_quantum'], 'return'], bins=5)
print(f"Quantum moment return entropy: {quantum_entropy:.2f}")
print(f"Non-quantum moment return entropy: {non_quantum_entropy:.2f}")
