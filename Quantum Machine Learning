    kernel_matrix_train_q = quantum_kernel_q.evaluate(x_vec=Xq_train)
    kernel_matrix_test_q = quantum_kernel_q.evaluate(x_vec=Xq_test, y_vec=Xq_train)
    svm_q = SVC(kernel='precomputed')
    svm_q.fit(kernel_matrix_train_q, yq_train)
    yq_pred = svm_q.predict(kernel_matrix_test_q)
    print("\n--- Quantum SVM, Quantum Moments Only ---")
    print(classification_report(yq_test, yq_pred, digits=4))
else:
